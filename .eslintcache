ry']} component={History}>\n            <History />\n          </Route>\n          <Route exact path={['/visit']} component={Visit}>\n            <Visit />\n          </Route>\n          <Route exact path={['/events']} component={Events}>\n            <Events />\n          </Route>\n          <Route exact path={['/4th-july-watermelon-fest']} component={Watermelon}>\n            <Watermelon />\n          </Route>\n          <Route exact path={['/river']} component={River}>\n            <River />\n          </Route>\n          <Route exact path={['/blog-articles']} component={BlogArticleList}>\n            <BlogArticleList />\n          </Route>\n          <Route exact path={['/blog-article']} component={BlogArticle}>\n            <BlogArticle />\n          </Route>\n          <Route exact path={['/press']} component={Press}>\n            <Press />\n          </Route>\n          <Route exact path={['/maps']} component={Maps}>\n            <Maps />\n          </Route>\n        </Switch>\n      </Router>\n    </>\n  );\n}\n\nexport default App;\n","/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/pages/Press/Press.js",[],"/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/pages/River/River.js",[],"/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/data/BlogData.js",[],"/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/components/CarouselModal/CarouselModal.js",[],"/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/pages/BlogArticleListItem/BlogArticleListItem.js",[],["92","93"],"/Users/timgangl/Documents/web-dev-projects/discover-colusa/src/pages/Home/Home.js",["94","95","96","97","98"],"import React from 'react';\n// import VideoHeader from '../../components/VideoHeader';\nimport PhotoCarousel from '../../components/PhotoCarousel/PhotoCarousel';\nimport '../../components/PhotoCarousel/PhotoCarousel.css';\nimport Navigation from '../../components/Navigation/Navigation';\nimport '../../components/Navigation/N